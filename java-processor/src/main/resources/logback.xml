<configuration>
    <!-- Without this file logback defaults to DEBUG on stdout, and parquet-mr/hadoop
         log several lines per page/column write - measurable overhead on a 800M-row job. -->
    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder><pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern></encoder>
    </appender>
    <root level="WARN"><appender-ref ref="STDERR"/></root>
</configuration>
